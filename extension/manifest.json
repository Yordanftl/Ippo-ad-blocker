{
  "manifest_version": 3,
  "name": "Ippo AdBlocker",
  "version": "2.0.1",
  "description": "Blocks 132k+ ad/tracker rules (EasyList, EasyPrivacy, AdGuard Base), YouTube video ads, popups, and hides leftover ad containers.",
  "permissions": ["declarativeNetRequest", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules/rules_1.json"
      },
      {
        "id": "ruleset_2",
        "enabled": true,
        "path": "rules/rules_2.json"
      },
      {
        "id": "ruleset_3",
        "enabled": true,
        "path": "rules/rules_3.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["src/inject.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "css": ["src/generic-cosmetic.css", "src/cosmetic.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Ippo AdBlocker"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
